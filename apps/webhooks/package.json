{
  "private": true,
  "name": "app-webhooks",
  "description": "A Commerce Layer Single Page Application to manage webhooks with a nice GUI.",
  "version": "6.3.0",
  "license": "MIT",
  "keywords": [
    "reactjs",
    "jamstack",
    "headless",
    "ecommerce",
    "api",
    "webhooks",
    "commercelayer"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "pnpm biome check",
    "check:fix": "pnpm biome check --write",
    "ts:check": "tsc -b --noEmit",
    "test": "pnpm run check && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@commercelayer/app-elements": "catalog:",
    "@commercelayer/sdk": "catalog:",
    "@hookform/resolvers": "catalog:",
    "dashboard-apps-common": "workspace:*",
    "lodash-es": "catalog:",
    "phosphor-react": "^1.4.1",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-hook-form": "catalog:",
    "swr": "catalog:",
    "type-fest": "catalog:",
    "wouter": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commercelayer/app-builder": "workspace:*",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
    "rollup-plugin-external-globals": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vite-tsconfig-paths": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  }
}
