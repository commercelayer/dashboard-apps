    "lodash-es": "catalog:",
    "papaparse": "^5.7.0",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-select": "^5.10.2",
    "wouter": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@commercelayer/app-builder": "workspace:*",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/lodash-es": "catalog:",
    "@types/node": "catalog:",
    "@types/papaparse": "^5.5.2",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "dotenv": "catalog:",
    "i18next": "catalog:",
    "jsdom": "catalog:",
