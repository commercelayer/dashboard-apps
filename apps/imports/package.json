{
  "name": "app-imports",
  "description": "A Commerce Layer Single Page Application to import resources with a nice GUI.",
  "version": "6.0.0-new-payments.1",
  "type": "module",
  "private": true,
  "license": "MIT",
  "keywords": [
    "reactjs",
    "jamstack",
    "headless",
    "ecommerce",
    "api",
    "imports",
    "commercelayer"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "pnpm biome check",
    "check:fix": "pnpm biome check --write",
    "ts:check": "tsc -b --noEmit",
    "test": "pnpm run check && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests"
  },
  "dependencies": {
    "@commercelayer/app-elements": "catalog:",
