{
  "private": true,
  "name": "app-subscriptions",
  "description": "A Commerce Layer Single Page Application to manage subscriptions with a nice GUI.",
  "version": "5.1.1",
  "license": "MIT",
  "keywords": [
    "reactjs",
    "jamstack",
    "headless",
    "ecommerce",
    "api",
    "subscriptions",
    "commercelayer"
  ],
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "check": "pnpm biome check",
    "check:fix": "pnpm biome check --write",
    "ts:check": "tsc -b --noEmit",
    "test": "pnpm run check && vitest run --passWithNoTests",
    "test:watch": "vitest --passWithNoTests",
    "prepare": "touch ./public/config.local.js"
  },
  "dependencies": {
    "@commercelayer/app-elements": "7.16.0",
    "@commercelayer/sdk": "8.0.0-beta.11",
    "@hookform/resolvers": "^3.10.0",
    "dashboard-apps-common": "workspace:*",
    "lodash-es": "^4.18.1",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "7.62.0",
    "swr": "^2.5.1",
    "type-fest": "^5.8.0",
    "wouter": "^3.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@commercelayer/app-builder": "workspace:*",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "22.13.4",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^5.2.0",
    "cronstrue": "^3.24.0",
    "i18next": "^25.10.10",
    "jsdom": "^27.4.0",
    "rollup-plugin-external-globals": "^0.13.0",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vite-tsconfig-paths": "^5.1.4",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  }
}
